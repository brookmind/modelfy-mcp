{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelfy-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: client ID metadata documents are fetched
  // from the public internet only
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }],
  // ANON_CALLS: calls per anonymous sandbox key. KEY_REQUESTS: one sandbox
  // key or device code request per address every 10 seconds, so requests
  // fired together cannot all pass the hourly limit kept in KV. Both are
  // counted per Cloudflare location, with no KV writes; namespace ids are
  // unique per account, so each env has its own. This top-level (local and
  // tests) KEY_REQUESTS is loose: tests ask for many keys in a row
  "ratelimits": [
    {
      "name": "ANON_CALLS",
      "namespace_id": "4100",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "KEY_REQUESTS",
      "namespace_id": "4110",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "API_URL": "http://localhost:3000",
    "WEB_URL": "http://localhost:5173",
    "PUBLIC_URL": "http://localhost:8787",
    // Evals only: sandbox keys with the bare agent layer (never in production)
    "ALLOW_BARE_AGENT_LAYER": "true",
    "SANDBOX_KEYS_PER_HOUR": "5",
  },
  "env": {
    "dev": {
      "routes": [{ "pattern": "mcp-dev.modelfy.ai", "custom_domain": true }],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "fb46029047e94a688e631bb5ba20480c" },
      ],
      "ratelimits": [
        {
          "name": "ANON_CALLS",
          "namespace_id": "4101",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          // Evals ask for many keys from one address
          "name": "KEY_REQUESTS",
          "namespace_id": "4111",
          "simple": { "limit": 200, "period": 60 },
        },
      ],
      "vars": {
        "API_URL": "https://api-dev.modelfy.ai",
        "WEB_URL": "https://beta-dev.modelfy.ai",
        "PUBLIC_URL": "https://mcp-dev.modelfy.ai",
        "ALLOW_BARE_AGENT_LAYER": "true",
        "SANDBOX_KEYS_PER_HOUR": "200",
      },
    },
    "production": {
      "routes": [{ "pattern": "mcp.modelfy.ai", "custom_domain": true }],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "TO_BE_CREATED_PRODUCTION" },
      ],
      "ratelimits": [
        {
          "name": "ANON_CALLS",
          "namespace_id": "4102",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "KEY_REQUESTS",
          "namespace_id": "4112",
          "simple": { "limit": 1, "period": 10 },
        },
      ],
      "vars": {
        "API_URL": "https://api.modelfy.ai",
        "WEB_URL": "https://beta.modelfy.ai",
        "PUBLIC_URL": "https://mcp.modelfy.ai",
        "ALLOW_BARE_AGENT_LAYER": "false",
        "SANDBOX_KEYS_PER_HOUR": "5",
      },
    },
  },
}
